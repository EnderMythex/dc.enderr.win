# Discord application used for login (https://discord.com/developers/applications > OAuth2).
# Redirect URI to register on Discord: <PUBLIC_URL>/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of the panel, without trailing slash.
# Production: https://dc.enderr.win
PUBLIC_URL=http://localhost:8080

# HTTP listen address.
BIND_ADDR=127.0.0.1:8080

# SQLite database for users and sessions (created automatically).
DATABASE_URL=sqlite://data/panel.db

# Folder with one sub-folder per bot (see bots/_template).
BOTS_DIR=bots

# Comma-separated Discord user ids that can see and manage every bot.
ADMIN_IDS=

# Group id of /var/run/docker.sock on the host (compose.yaml only): stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Shown on the legal pages (/legal, /privacy, /terms). The address can use
# commas for line breaks.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
